{
    "name": "grafite/maintenance",
    "description": "A handy set of commands for app maintenance",
    "license": "MIT",
    "authors": [
        {
            "name": "Matt Lantz",
            "email": "mattlantz@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "illuminate/support": "^12.0|^13.0",
        "mikehaertl/php-shellcommand": "^1.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "mockery/mockery": "^1.0",
        "orchestra/testbench": "^10.0|^11.0"
    },
    "suggest": {
        "grafite/mission-control-laravel": "Send maintenance:report and maintenance:audit payloads to Mission Control"
    },
    "autoload": {
        "psr-4": {
            "Grafite\\Maintenance\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Grafite\\Maintenance\\GrafiteMaintenanceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
